# Copy to .env. Do not commit a real API key to Git or put it in the website files.
PORT=3000
RAILKIT_API_KEY=PASTE_YOUR_OWN_RAILKIT_KEY_HERE
# For testing with your own mock server only; leave this default for real use:
RAILKIT_API_URL=https://api.railkit.in
# Set this only if you control/trust the reverse proxy in front of this server.
TRUST_PROXY=false
